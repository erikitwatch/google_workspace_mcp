# Secrets for the Cloudflare deployment of the Google Workspace MCP server.
#
# NOTHING IN THIS FILE IS READ AT RUNTIME. Non-secret settings live in
# wrangler.toml [vars]; the values below are Worker secrets, set once with
# `wrangler secret put` (or `./set-secrets.sh` after filling in a local copy
# named .env, which is git-ignored). The Worker copies them into the
# container's environment at start.
#
# Copy to .env, fill in, run:  sh ./set-secrets.sh

# ---------------------------------------------------------------------------
# Google OAuth client (deploy/GCP-SETUP.md)
# Web application client in the Watchman IT GCP project. Redirect URI must be
# exactly https://mcp.wmtech.app/wit/google/oauth2callback
# ---------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Encryption / signing key for the OAuth proxy state in Valkey and the bearer
# tokens issued to MCP clients. Set it explicitly so rotating the Google client
# secret does not invalidate every stored login.
# Generate:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating THIS key logs every user out.
# ---------------------------------------------------------------------------
FASTMCP_SERVER_AUTH_GOOGLE_JWT_SIGNING_KEY=

# ---------------------------------------------------------------------------
# Valkey/Redis (Upstash). Create a free Redis database at https://console.upstash.com
# in a US-East region, TLS on. Put the endpoint hostname in wrangler.toml
# (WORKSPACE_MCP_OAUTH_PROXY_VALKEY_HOST); the password is the secret.
# ---------------------------------------------------------------------------
WORKSPACE_MCP_OAUTH_PROXY_VALKEY_PASSWORD=
